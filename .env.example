# Database
MONGODB_URI="mongodb+srv://…"
MONGODB_DB="hali"

# Host shown in captions / shop links, and the public origin of the app
NEXT_PUBLIC_APP_HOST="shop.app"
APP_URL="http://localhost:3000"

# Google sign-in (optional — the button is hidden without these)
# Redirect URI to register: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo fixture shop to seed ("off" to disable)
HALI_DEMO_SHOP="shania"
# This vendor inherits shops created before accounts existed
HALI_LEGACY_OWNER_EMAIL=""
# Day boundaries for metrics
HALI_TIMEZONE="Africa/Kampala"
